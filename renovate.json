{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor"
  ],
  "dependencyDashboard": false,
  "ignorePaths": [
    "**/node_modules/**",
    "fixtures/**",
    "experiments/**",
    "tools/ladder/**"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "gradle-wrapper"
      ],
      "groupName": "build toolchain"
    },
    {
      "matchPackageNames": [
        "/^org\\.jetbrains\\.kotlin[.:]/",
        "/^org\\.jetbrains\\.compose/",
        "/^com\\.android/"
      ],
      "groupName": "build toolchain"
    },
    {
      "matchDepNames": [
        "node",
        "java-jdk",
        "ubuntu"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "matchDatasources": [
        "github-runners"
      ],
      "enabled": false
    }
  ]
}
