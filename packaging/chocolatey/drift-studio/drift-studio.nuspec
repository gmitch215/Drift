<?xml version="1.0" encoding="utf-8"?>
<package xmlns="http://schemas.microsoft.com/packaging/2015/06/nuspec.xsd">
	<metadata>
		<id>drift-studio</id>
		<version>@version@</version>
		<packageSourceUrl>https://github.com/gmitch215/Drift/tree/v@version@/packaging/chocolatey/drift-studio</packageSourceUrl>
		<owners>gmitch215</owners>
		<title>Drift Studio</title>
		<authors>Gregory Mitchell</authors>
		<projectUrl>https://github.com/gmitch215/Drift</projectUrl>
		<iconUrl>https://cdn.jsdelivr.net/gh/gmitch215/Drift@v@version@/assets/drift.png</iconUrl>
		<copyright>Copyright (c) 2026 Gregory Mitchell</copyright>
		<licenseUrl>https://github.com/gmitch215/Drift/blob/v@version@/LICENSE</licenseUrl>
		<requireLicenseAcceptance>false</requireLicenseAcceptance>
		<projectSourceUrl>https://github.com/gmitch215/Drift/tree/v@version@</projectSourceUrl>
		<docsUrl>https://github.com/gmitch215/Drift/blob/v@version@/README.md</docsUrl>
		<bugTrackerUrl>https://github.com/gmitch215/Drift/issues</bugTrackerUrl>
		<tags>drift kotlin diagnostics reproducibility gui</tags>
		<summary>Explore how Kotlin behaves across platforms</summary>
		<description>Drift Studio is the desktop app of the Drift diagnosis engine. It opens on the Kotlin Portability Atlas, a recorded set of probes of Kotlin behavior on the JVM, native, Wasm, Android and iOS, adds a column for the device it runs on, and has a predict-and-reveal mode.

The package installs the Windows x64 installer from the GitHub release silently, for all users. The app is unsigned, so Windows SmartScreen may warn the first time it starts.

The command line tool is the separate `drift` package.</description>
		<releaseNotes>https://github.com/gmitch215/Drift/releases/tag/v@version@</releaseNotes>
	</metadata>
	<files>
		<file src="tools\**" target="tools" />
	</files>
</package>
