#!/usr/bin/env bash
set -euo pipefail

staged() {
	git diff --cached --name-only --diff-filter=ACMRT | grep -E "$1" || true
}

kotlin_files=()
while IFS= read -r file; do
	kotlin_files+=("$file")
done < <(staged '\.(kt|kts)$')

if [[ ${#kotlin_files[@]} -gt 0 ]]; then
	echo "[pre-commit] Running spotless on ${#kotlin_files[@]} file(s)..."
	./gradlew spotlessApply checkLineLength --quiet --offline || {
		echo "[pre-commit] spotless or the line-length check failed" >&2
		exit 1
	}
	for f in "${kotlin_files[@]}"; do
		[[ -f $f ]] && git add "$f"
	done
fi

other_files=()
while IFS= read -r file; do
	other_files+=("$file")
done < <(staged '\.(json|yml|yaml|md)$')

if [[ ${#other_files[@]} -gt 0 ]]; then
	# prettier is optional, so a machine without it skips instead of blocking
	if command -v prettier > /dev/null 2>&1; then
		echo "[pre-commit] Running prettier on ${#other_files[@]} file(s)..."
		for f in "${other_files[@]}"; do
			[[ -f $f ]] || continue
			prettier --write --ignore-unknown "$f" > /dev/null
			git add "$f"
		done
	else
		echo "[pre-commit] prettier not installed, skipping ${#other_files[@]} file(s)" >&2
	fi
fi

exit 0
